    <string name="ui_speaker_dialer_body">Standart telefon ilovasi sifatida Alo Answer qoʻngʻiroqni karnayga oʻzi oʻtkazdi.</string>
    <string name="ui_speaker_dialer_head">Karnay yoqildi</string>
    <string name="ui_speaker_fail_body">Qoʻngʻiroqqa javob berildi, lekin Android maʼlumotiga koʻra ovoz telefonning yuqori dinamigida qoldi. Ilova qoʻngʻiroq ekranidagi «Karnay» tugmasini oʻzi bosishi uchun pastdagi «Avto-karnay»ni yoqing.</string>
    <string name="ui_speaker_fail_head">Karnayga oʻtkazish ishlamadi</string>
    <string name="ui_speaker_kept_body">Bluetooth qurilma yoki quloqchin ulangan edi, shuning uchun qoʻngʻiroq oddiy telefondagidek oʻshanda qoldi. Karnay faqat hech narsa ulanmaganda yoqiladi. Qoʻngʻiroq ekranidagi ovoz tugmasi bilan almashtirsa boʻladi.</string>
    <string name="ui_speaker_kept_head">Bluetooth/quloqchinda qoldi</string>
    <string name="ui_speaker_none_body">Ilova qoʻngʻiroqqa javob bergandan keyin karnayga oʻtkazish natijasi shu yerda koʻrinadi.</string>
    <string name="ui_speaker_none_head">Hali qoʻngʻiroqqa javob berilmagan</string>
    <string name="ui_speaker_ok_body">Bu faqat Android soʻrovni qabul qilganini bildiradi. Standart telefon ilovasi boʻlmagan ilova qoʻngʻiroq ovozini ishonchli boshqara olmaydi, shuning uchun oxirgi qoʻngʻiroq haqiqatan karnaydan eshitilganini quloq bilan tekshiring.</string>
